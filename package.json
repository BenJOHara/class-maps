{
    "name": "class-maps",
    "publisher": "ClassMaps",
    "displayName": "SystemC Map",
    "description": "Visualise an elaborated SystemC module hierarchy in VS Code",
    "version": "0.1.0",
    "engines": {
        "vscode": "^1.65.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onView:class-maps.map-view",
        "onCommand:class-maps.refresh-systemc-hierarchy"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "views": {
            "explorer": [
                {
                    "type": "webview",
                    "id": "class-maps.map-view",
                    "name": "SystemC Map"
                }
            ]
        },
        "commands": [
            {
                "command": "class-maps.refresh-systemc-hierarchy",
                "category": "SystemC Map",
                "title": "Refresh Hierarchy"
            }
        ],
        "configuration": {
            "title": "SystemC Map",
            "properties": {
                "class-maps.systemcMapPath": {
                    "type": "string",
                    "default": "systemc-map.json",
                    "description": "Path to the SystemC hierarchy JSON file, relative to the first workspace folder."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "webpack",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/vscode": "^1.65.0",
        "@types/glob": "^7.2.0",
        "@types/mocha": "^9.0.0",
        "@types/node": "14.x",
        "@typescript-eslint/eslint-plugin": "^5.9.1",
        "@typescript-eslint/parser": "^5.9.1",
        "eslint": "^8.6.0",
        "glob": "^7.2.0",
        "mocha": "^9.1.3",
        "typescript": "^4.5.4",
        "ts-loader": "^9.2.6",
        "webpack": "^5.66.0",
        "webpack-cli": "^4.9.1",
        "@vscode/test-electron": "^2.0.3"
    }
}
